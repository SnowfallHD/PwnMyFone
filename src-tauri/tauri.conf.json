{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PwnMyFone",
  "version": "0.1.0",
  "identifier": "com.snowfallhd.pwnmyfone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PwnMyFone",
        "width": 1120,
        "height": 820,
        "minWidth": 620,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/PwnMyFone.icns"],
    "resources": {
      "helpers/": "helpers/"
    }
  }
}
